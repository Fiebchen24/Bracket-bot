<!doctype html>
<html>
<head>
  <title>Bracket Events Dashboard</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
<main class="card wide">
  <a href="/dashboard">← Back</a>
  <h1>Bracket Events</h1>
  <p><b>Server:</b> <%= meta && meta.guildName ? meta.guildName : guildId %> · <span class="badge <%= access && access.canAdmin ? 'reported' : 'pending' %>"><%= access && access.canAdmin ? 'Host/Admin view' : (access && access.canView ? 'Player view' : 'No access') %></span></p>

  <% function playerLabel(p){ if(!p) return ''; if(typeof p === 'string') return p; return p.displayName || p.username || p.id || ''; } %>
  <% function playerAvatar(p){ if(!p || typeof p === 'string') return null; return p.avatarUrl || null; } %>
  <% function teamPlayers(team){ return team && team.player_details && team.player_details.length ? team.player_details : (team && team.players ? team.players.map(id=>({id,displayName:id,username:id,avatarUrl:null})) : []); } %>
  <% function teamAvatar(team){ const first = teamPlayers(team)[0]; return playerAvatar(first); } %>
  <% function teamSub(team){ return teamPlayers(team).map(playerLabel).join(' · '); } %>
  <% function matchStatus(match){ if(match.status === 'approved') return 'FINISHED'; if(match.status === 'reported') return 'REPORTED'; if(match.status === 'bye') return 'BYE'; return 'LIVE'; } %>

  <section class="panel">
    <h2>Active Tournaments</h2>
    <% if(tournaments && tournaments.length){ %>
      <div class="pill-row">
        <% tournaments.forEach(t=>{ %>
          <a class="pill <%= tournament && tournament.id===t.id ? 'active' : '' %>" href="/guild/<%= guildId %>?tournament_id=<%= t.id %>">#<%= t.id %> <%= t.name %> · <%= t.status %></a>
        <% }) %>
      </div>
    <% } else { %>
      <p>No active tournaments. Create events in Discord with <code>/createbracket</code> so channels can be selected safely.</p>
    <% } %>
  </section>

  <% if(tournament){ %>
    <section class="panel hero">
      <div>
        <h2>#<%= tournament.id %> <%= tournament.name %></h2>
        <p><b><%= tournament.team_size %>v<%= tournament.team_size %></b> · <%= tournament.format %> · <%= tournament.status %></p>
        <p>Signup: <b><%= meta.channels[tournament.signup_channel_id] || tournament.signup_channel_id %></b> · Bracket: <b><%= meta.channels[tournament.bracket_channel_id] || tournament.bracket_channel_id %></b> · Check-in: <b><%= tournament.require_checkin ? (meta.channels[tournament.checkin_channel_id] || 'required') : 'Off' %></b></p>
        <% if(tournament.match_category_id){ %><p>Matches: <b><%= meta.channels[tournament.match_category_id] || tournament.match_category_id %></b></p><% } %>
        <% if(tournament.registration_role_id){ %><p>Registration Role: <b><%= meta.roles[tournament.registration_role_id] || tournament.registration_role_id %></b></p><% } %>
        <% if(tournament.staff_role_id){ %><p>Host/Staff Role: <b><%= meta.roles[tournament.staff_role_id] || tournament.staff_role_id %></b></p><% } %>
      </div>
      <% if(access && access.canAdmin){ %>
      <div class="actions">
        <% if(tournament.status === 'registration'){ %>
        <form method="post" action="/guild/<%= guildId %>/start"><input type="hidden" name="tournament_id" value="<%= tournament.id %>"><button class="btn">Start Bracket</button></form>
        <% } %>
        <form method="post" action="/guild/<%= guildId %>/reset"><input type="hidden" name="tournament_id" value="<%= tournament.id %>"><button class="danger">End Tournament</button></form>
      </div>
      <% } %>
    </section>

    <section class="grid2">
      <div class="panel">
        <h2>Teams</h2>
        <% if(data.teams.length){ %>
          <% data.teams.forEach(team=>{ const players = teamPlayers(team); %>
            <div class="team-card pretty-team">
              <div class="team-head">
                <% if(teamAvatar(team)){ %><img class="avatar" src="<%= teamAvatar(team) %>" alt=""><% } else { %><span class="avatar fallback"><%= team.name.slice(0,1).toUpperCase() %></span><% } %>
                <% if(access && access.canAdmin){ %>
                  <form method="post" action="/guild/<%= guildId %>/edit-team" class="inline-form team-edit">
                    <input type="hidden" name="team_id" value="<%= team.id %>">
                    <input name="name" value="<%= team.name %>">
                    <button>Save</button>
                  </form>
                <% } else { %>
                  <div class="team-title"><b><%= team.name %></b></div>
                <% } %>
              </div>
              <div class="player-list">
                <% players.forEach(p=>{ %>
                  <span class="player-chip"><% if(playerAvatar(p)){ %><img src="<%= playerAvatar(p) %>" alt=""><% } %><%= playerLabel(p) %></span>
                <% }) %>
              </div>
              <div><%= team.checked_in ? '✅ Checked in' : tournament.require_checkin ? '⏳ Not checked in' : '➖ Check-in off' %></div>
              <% if(access && access.canAdmin && tournament.status === 'registration'){ %>
              <form method="post" action="/guild/<%= guildId %>/remove-team"><input type="hidden" name="team_id" value="<%= team.id %>"><button class="danger small">Remove</button></form>
              <% } %>
            </div>
          <% }) %>
        <% } else { %><p>No teams yet.</p><% } %>
      </div>

      <% if(access && access.canAdmin){ %>
      <div class="panel">
        <h2>Admin Controls</h2>
        <form method="post" action="/guild/<%= guildId %>/approve" class="stacked"><label>Approve reported match ID</label><input name="match_id" placeholder="Match ID"><button>Approve</button></form>
        <form method="post" action="/guild/<%= guildId %>/force" class="stacked"><label>Force match winner</label><input name="match_id" placeholder="Match ID"><input name="winner_team_id" placeholder="Winner Team ID"><button>Force Win</button></form>
        <h3>Logs</h3>
        <div class="logs"><% logs.forEach(l=>{ %><div><b><%= l.action %></b> · <%= l.details %></div><% }) %></div>
      </div>
      <% } else { %>
      <div class="panel">
        <h2>Viewer Access</h2>
        <p>You can view the live bracket and team list because you have the tournament registration role. Admin controls are hidden for players.</p>
      </div>
      <% } %>
    </section>

    <section class="panel bracket-panel">
      <% if(tournament.format === 'round_robin'){ %>
        <h2>Round Robin Standings</h2>
        <%
          const stats = new Map();
          data.teams.forEach(t => stats.set(t.id, {team:t, played:0, wins:0, losses:0}));
          data.matches.forEach(m => {
            if(m.status === 'approved' || m.status === 'bye'){
              const ids = [m.team1_id, m.team2_id].filter(Boolean);
              ids.forEach(id => { if(stats.has(id)) stats.get(id).played++; });
              if(m.winner_team_id && stats.has(m.winner_team_id)) stats.get(m.winner_team_id).wins++;
              ids.filter(id => id !== m.winner_team_id).forEach(id => { if(stats.has(id)) stats.get(id).losses++; });
            }
          });
          const standings = Array.from(stats.values()).sort((a,b)=> b.wins-a.wins || a.losses-b.losses || a.team.name.localeCompare(b.team.name));
        %>
        <table class="round-robin-table">
          <thead><tr><th>#</th><th>Team</th><th>Played</th><th>Wins</th><th>Losses</th></tr></thead>
          <tbody>
          <% standings.forEach((row,i)=>{ %>
            <tr><td><%= i+1 %></td><td><span class="rr-team"><% if(teamAvatar(row.team)){ %><img class="avatar sm" src="<%= teamAvatar(row.team) %>" alt=""><% } %><b><%= row.team.name %></b></span></td><td><%= row.played %></td><td><%= row.wins %></td><td><%= row.losses %></td></tr>
          <% }) %>
          </tbody>
        </table>
        <h2 style="margin-top:24px">Round Robin Matches</h2>
      <% } else { %>
        <h2>Graphic Bracket Tree</h2>
      <% } %>
      <% const groups = tournament.format === 'round_robin' ? ['round_robin'] : ['winners','losers','grand']; const labels = {winners:'Winner Bracket', losers:'Loser Bracket', grand:'Grand Final', round_robin:'Matches'}; %>
      <% groups.forEach(group=>{ const gm = data.matches.filter(m => (m.bracket_group || 'winners') === group); if(!gm.length) return; const rounds = [...new Set(gm.map(m=>m.round))].sort((a,b)=>a-b); %>
        <div class="bracket-section <%= group %>">
          <h3><%= labels[group] %></h3>
          <div class="bracket-scroll svg-bracket-scroll">
            <svg class="connector-svg" aria-hidden="true"></svg>
            <div class="bracket-tree svg-bracket-tree">
              <% rounds.forEach(round=>{ const rm = gm.filter(m=>m.round===round).sort((a,b)=>a.match_number-b.match_number); %>
                <div class="round-column" data-round="<%= round %>">
                  <div class="round-title">Round <%= round %></div>
                  <% rm.forEach((match, idx)=>{ %>
                    <div class="match-box <%= match.status %>" data-match-index="<%= idx %>">
                      <div class="match-top"><span class="match-id">#<%= match.id %> · M<%= match.match_number %></span><span class="badge <%= match.status %>"><%= matchStatus(match) %></span></div>
                      <% [match.team1, match.team2].forEach((tm, idx)=>{ const isWinner = tm && match.winner_team_id === tm.id; const av = tm ? teamAvatar(tm) : null; %>
                        <div class="slot <%= isWinner ? 'winner' : '' %> <%= tm ? '' : 'bye-slot' %>">
                          <% if(tm){ %>
                            <% if(av){ %><img class="avatar sm" src="<%= av %>" alt=""><% } else { %><span class="avatar sm fallback"><%= tm.name.slice(0,1).toUpperCase() %></span><% } %>
                            <div class="team-text"><span><%= tm.name %></span><small><%= teamSub(tm) %></small></div>
                            <% if(isWinner){ %><b class="win-tag">WIN</b><% } %>
                          <% } else { %>
                            <div class="bye-label">BYE</div>
                          <% } %>
                        </div>
                      <% }) %>
                      <div class="status-line"><% if(match.reportedWinner){ %><span class="reported-chip">Reported: <%= match.reportedWinner.name %></span><% } else { %><span class="muted">Waiting</span><% } %></div>
                      <% if(access && access.canAdmin && match.status !== 'approved' && match.status !== 'bye' && match.team1 && match.team2){ %>
                      <form method="post" action="/guild/<%= guildId %>/force" class="mini-actions">
                        <input type="hidden" name="match_id" value="<%= match.id %>">
                        <button name="winner_team_id" value="<%= match.team1.id %>">Win <%= match.team1.name %></button>
                        <button name="winner_team_id" value="<%= match.team2.id %>">Win <%= match.team2.name %></button>
                      </form>
                      <% } %>
                    </div>
                  <% }) %>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      <% }) %>
    </section>

    <section class="panel">
      <h2>Text Bracket</h2>
      <pre><%= bracketText %></pre>
    </section>
  <% } %>
</main>

<script>
(function(){
  function drawConnectors(){
    document.querySelectorAll('.svg-bracket-scroll').forEach(scroll => {
      const svg = scroll.querySelector('.connector-svg');
      const tree = scroll.querySelector('.svg-bracket-tree');
      if(!svg || !tree) return;
      const columns = Array.from(tree.querySelectorAll('.round-column'));
      const treeRect = tree.getBoundingClientRect();
      const width = Math.max(tree.scrollWidth, scroll.scrollWidth);
      const height = Math.max(tree.scrollHeight, scroll.scrollHeight);
      svg.setAttribute('width', width);
      svg.setAttribute('height', height);
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.innerHTML = '';
      columns.forEach((col, colIndex) => {
        const next = columns[colIndex + 1];
        if(!next) return;
        const fromMatches = Array.from(col.querySelectorAll('.match-box'));
        const toMatches = Array.from(next.querySelectorAll('.match-box'));
        fromMatches.forEach((from, i) => {
          const to = toMatches[Math.floor(i / 2)] || toMatches[i] || toMatches[0];
          if(!to) return;
          const a = from.getBoundingClientRect();
          const b = to.getBoundingClientRect();
          const x1 = a.right - treeRect.left;
          const y1 = a.top + a.height / 2 - treeRect.top;
          const x2 = b.left - treeRect.left;
          const y2 = b.top + b.height / 2 - treeRect.top;
          if(x2 <= x1) return;
          const mid = x1 + Math.max(28, (x2 - x1) / 2);
          const p = document.createElementNS('http://www.w3.org/2000/svg','path');
          p.setAttribute('d', `M ${x1} ${y1} C ${mid} ${y1}, ${mid} ${y2}, ${x2} ${y2}`);
          p.setAttribute('class','connector-path');
          svg.appendChild(p);
        });
      });
    });
  }
  window.addEventListener('load', drawConnectors);
  window.addEventListener('resize', drawConnectors);
  document.querySelectorAll('.bracket-scroll').forEach(el => el.addEventListener('scroll', () => requestAnimationFrame(drawConnectors), {passive:true}));
  setTimeout(drawConnectors, 250);
})();
</script>
</body>
</html>

<!doctype html><html><head><title>Guild Admin</title><link rel="stylesheet" href="/public/style.css"></head><body><main class="card wide"><a href="/dashboard">← Back</a><h1>Guild Admin</h1><p>Guild ID: <code><%= guildId %></code></p><h2>Active Tournament</h2><% if(tournament){ %><p><b><%= tournament.name %></b> — <%= tournament.team_size %>v<%= tournament.team_size %> — <%= tournament.format %> — <%= tournament.status %></p><pre><%= bracketText %></pre><form method="post" action="/guild/<%= guildId %>/start"><button class="btn">Start Bracket</button></form><form method="post" action="/guild/<%= guildId %>/approve"><input name="match_id" placeholder="Match ID"><button>Approve reported win</button></form><form method="post" action="/guild/<%= guildId %>/reset"><button class="danger">Reset/End</button></form><% } else { %><form method="post" action="/guild/<%= guildId %>/create"><input name="name" placeholder="Tournament name" required><select name="team_size"><option value="1">1v1</option><option value="2">2v2</option><option value="3">3v3</option><option value="4">4v4</option></select><select name="format"><option value="single">Single Elimination</option><option value="double">Double Elimination</option></select><button class="btn">Create Tournament</button></form><% } %></main></body></html>

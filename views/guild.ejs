<!doctype html><html><head><title>Guild Admin</title><link rel="stylesheet" href="/public/style.css"></head><body><main class="card wide"><a href="/dashboard">← Back</a><h1>Guild Admin</h1><p>Guild ID: <code><%= guildId %></code></p>
<h2>Active Tournaments</h2>
<% if(tournaments && tournaments.length){ %><ul><% tournaments.forEach(t=>{ %><li><a href="/guild/<%= guildId %>?tournament_id=<%= t.id %>">#<%= t.id %> <%= t.name %></a> — <%= t.status %> — signup <code><%= t.signup_channel_id %></code></li><% }) %></ul><% } else { %><p>No active tournaments. Create events in Discord with <code>/createbracket</code> so channels can be selected safely.</p><% } %>
<h2>Selected Tournament</h2>
<% if(tournament){ %><p><b>#<%= tournament.id %> <%= tournament.name %></b> — <%= tournament.team_size %>v<%= tournament.team_size %> — <%= tournament.format %> — <%= tournament.status %></p><p>Signup: <code><%= tournament.signup_channel_id %></code> | Bracket: <code><%= tournament.bracket_channel_id %></code></p><pre><%= bracketText %></pre><form method="post" action="/guild/<%= guildId %>/start"><input type="hidden" name="tournament_id" value="<%= tournament.id %>"><button class="btn">Start Bracket</button></form><form method="post" action="/guild/<%= guildId %>/approve"><input name="match_id" placeholder="Match ID"><button>Approve reported win</button></form><form method="post" action="/guild/<%= guildId %>/reset"><input type="hidden" name="tournament_id" value="<%= tournament.id %>"><button class="danger">Reset/End</button></form><% } %>
</main></body></html>
